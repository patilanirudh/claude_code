# Copy to .env and fill in as needed. docker-compose already sets
# DATABASE_URL/REDIS_URL for the backend container -- this file matters
# for running backend/app outside Docker, and for Feature 4 onward.

DATABASE_URL=postgresql+psycopg2://riskpulse:riskpulse@localhost:5432/riskpulse
REDIS_URL=redis://localhost:6379/0

# Used starting Feature 4 (multi-model comparison for the risk-narrative
# feature). Not required before that.
OPENROUTER_API_KEY=
